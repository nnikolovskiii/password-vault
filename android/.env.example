# Environment for android/build-apk.sh (release build + signing). The app itself reads no environment,
# and plain ./gradlew test / assembleDebug need none of these (only the SDK path in local.properties).
#
# build-apk.sh does not load a file: export these in your shell first. Keep a filled-in copy OUTSIDE
# this repository (build-apk.sh refuses a keystore or password file inside it), for example:
#   cp android/.env.example ~/.config/vault-build.env    # edit it
#   set -a; . ~/.config/vault-build.env; set +a; ./android/build-apk.sh
# Every variable is optional; the defaults are shown in the comments.

# --- Android SDK ------------------------------------------------------------------------------
# SDK root (default: $HOME/Android/Sdk). build-apk.sh writes it to android/local.properties.
ANDROID_HOME=
# Legacy alias some tools read (default: same as ANDROID_HOME).
ANDROID_SDK_ROOT=

# --- Release signing --------------------------------------------------------------------------
# PKCS12 keystore (default: ~/.android/vault.keystore). Created with an RSA 4096 key if missing.
VAULT_KEYSTORE=
# Key alias inside the keystore (default: vault).
VAULT_KEY_ALIAS=
# File holding the keystore password, mode 0600 (default: ~/.android/vault-keystore.pass).
# Created with a random password if missing and VAULT_KEY_PASS is unset.
VAULT_KEY_PASS_FILE=
# Keystore password directly, at least 16 characters. Leave empty to use VAULT_KEY_PASS_FILE.
VAULT_KEY_PASS=

# --- Output -----------------------------------------------------------------------------------
# Password of the zipped APK copy written to ~/Downloads/vault.zip (a transport wrapper, not a
# security boundary). Set your own.
VAULT_ZIP_PASS=change-me
